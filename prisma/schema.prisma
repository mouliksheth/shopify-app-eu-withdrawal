// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  id                    Int      @id @default(autoincrement())
  shopDomain            String   @unique
  isActive              Boolean  @default(true)
  withdrawalWindowDays  Int      @default(14)
  customEmailSubject    String   @default("Confirmation of Your Contract Withdrawal")
  customEmailBody       String   @default("We have received your request to withdraw from the contract. Here are your details:")
  buttonColor           String   @default("#000000")
  buttonTextColor       String   @default("#ffffff")
  buttonLabel           String   @default("Withdraw from Contract")
  buttonPlacement       String   @default("sticky_bottom_right") // sticky_bottom_right, sticky_bottom_left, inline
  limitToEU             Boolean  @default(false)
}

model WithdrawalRequest {
  id               Int      @id @default(autoincrement())
  shopDomain       String
  shopifyOrderId   String
  orderName        String
  customerEmail    String
  selectedItems    Json     // Array of line items with qty
  status           String   @default("pending_review") // pending_review, approved, rejected, completed
  submittedAt      DateTime @default(now())
  processedAt      DateTime?
  complianceNotes  String?
}
